DATABASE_URL=postgres://dsx:local-development-only@127.0.0.1:55432/dsx?sslmode=disable
DSX_ADDRESS=127.0.0.1:8080
DSX_MIGRATE=true
DSX_SEED=true
# User and inter-module authentication are intentionally omitted for this phase.
# JC owns durable report acceptance; Incident owns metadata PATCH and RCA production.
DSX_JOB_CONTROLLER_URL=http://127.0.0.1:8090
DSX_INCIDENT_URL=http://127.0.0.1:8091
# Example development policy; production values require operator configuration.
DSX_SCHEDULER_ENABLED=true
DSX_CATCHUP_WINDOW=168h
DSX_MAX_CATCHUP=10
DSX_DISPATCH_WINDOW=24h
DSX_JOB_DEADLINE=48h
DSX_EXECUTION_PROFILE_REVISION=local-v1
# O08 namespace requests only; install the matching JC profile before Backend rollout.
DSX_NAMESPACE_REPORT_PROFILE_REVISION=report-namespace-v1
# Exact host:port allowlist for model connection checks; empty disables checks.
DSX_MODEL_HOSTS=
# Private DNS destinations must also resolve inside an explicitly allowed CIDR.
DSX_MODEL_CIDRS=
# Model connection probes resolve only env:LLM_API_KEY; inject the value securely.
LLM_API_KEY=
# Explicitly opt in only when running in a trusted development container network.
DSX_ALLOW_UNAUTHENTICATED_NETWORK=false
