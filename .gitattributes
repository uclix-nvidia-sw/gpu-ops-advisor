# Keep working-tree text files consistently CRLF.
* text=auto eol=crlf

# Keep binary assets unchanged.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.zip -text
*.docx -text
*.xlsx -text
*.pptx -text
*.woff -text
*.woff2 -text

# Preserve generated diagram bytes for the recorded SHA-256 receipts.
docs/architecture/report-agent-workflow/*.html -text whitespace=cr-at-eol
docs/architecture/report-agent-workflow/report-agent.workflow.json -text whitespace=cr-at-eol
