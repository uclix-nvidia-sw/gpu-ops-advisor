{
  "name": "dsx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
