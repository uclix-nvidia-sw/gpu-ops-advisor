{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "components",
    "database",
    "postgres",
    "grafana",
    "llm",
    "configuration",
    "artifacts",
    "ingress"
  ],
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "frontend",
        "job-controller",
        "incident",
        "rcca-agent",
        "ops-agent",
        "grafana-mcp"
      ],
      "properties": {
        "backend": {
          "$ref": "#/definitions/component"
        },
        "frontend": {
          "$ref": "#/definitions/component"
        },
        "job-controller": {
          "$ref": "#/definitions/component"
        },
        "incident": {
          "$ref": "#/definitions/component"
        },
        "rcca-agent": {
          "$ref": "#/definitions/component"
        },
        "ops-agent": {
          "$ref": "#/definitions/component"
        },
        "grafana-mcp": {
          "$ref": "#/definitions/component"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "existingSecret",
        "urlKey",
        "passwordKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "global": {
      "type": "object",
      "required": [
        "imageRegistry",
        "imageNamespace",
        "imagePullPolicy",
        "imagePullSecrets"
      ],
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageNamespace": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "object"
        },
        "jobController": {
          "type": "object"
        },
        "incident": {
          "type": "object"
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "nameOverride": {
          "$ref": "#/definitions/resourceNameOverride"
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "nameOverride": {
              "$ref": "#/definitions/resourceNameOverride"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "image",
        "resources",
        "env"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "not": {
              "enum": [
                "DATABASE_URL",
                "LLM_API_KEY",
                "GRAFANA_SERVICE_ACCOUNT_TOKEN"
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resourceNameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    }
  }
}
